    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "pdfmake": "^0.3.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
